#!/usr/bin/env bash
# ./tussen — simply-tussen, built fresh from this checkout. Every command and flag is
# simply-tussen's own (`./tussen --help`), with two additions:
#
#   ./tussen install [--prefix DIR]   install simply-tussen into DIR/bin (default ~/.local/bin),
#                                     so `simply-tussen …` does what `./tussen …` does
#   ./tussen run …                    also opens the console in your browser
#                                     (TUSSEN_NO_OPEN=1 skips it; the binary never does)
#
# Start the hub with `./tussen run` (bare `./tussen` prints the help).
# Examples: ./tussen run · ./tussen run --fake-midi --fake-pad · ./tussen config init
# The hub prints its console URL and OSC endpoint on start; `run --stats` adds
# a counters line a second.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
HUB="$ROOT/hub/target/release/simply-tussen"

die() { echo "tussen: $*" >&2; exit 1; }

build_hub() {
  command -v cargo >/dev/null || die "cargo not found; install Rust from https://rustup.rs"
  (cd "$ROOT/hub" && cargo build --release --quiet)
}

install_hub() {
  local prefix="${PREFIX:-$HOME/.local}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --prefix) [ $# -ge 2 ] || die "--prefix needs a directory"; prefix="$2"; shift 2 ;;
      --prefix=*) prefix="${1#--prefix=}"; shift ;;
      *) die "install: unknown argument '$1' (usage: ./tussen install [--prefix DIR])" ;;
    esac
  done
  local bin="$prefix/bin"
  mkdir -p "$bin"
  # Copy beside, then rename over: a running simply-tussen is never rewritten in place.
  cp "$HUB" "$bin/.simply-tussen.new" && mv -f "$bin/.simply-tussen.new" "$bin/simply-tussen"
  echo "installed $bin/simply-tussen"
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) local rc="~/.profile"
       case "${SHELL:-}" in */zsh) rc="~/.zshrc" ;; */bash) rc="~/.bashrc" ;; esac
       echo "$bin is not on your PATH; add this line to $rc:"
       echo "  export PATH=\"$bin:\$PATH\"" ;;
  esac
}

# Relative paths in the args are the caller's; the hub runs from the repo root
# (where it finds the shipped hub.toml), so make --config absolute first.
ARGS=()
prev=""
for a in "$@"; do
  if [ "$prev" = "--config" ] && [ "${a#/}" = "$a" ]; then a="$PWD/$a"; fi
  case "$a" in --config=*) v="${a#--config=}"; [ "${v#/}" = "$v" ] && a="--config=$PWD/$v" ;; esac
  ARGS+=("$a"); prev="$a"
done

# The console's port from the config the hub will use (`simply-tussen config path`:
# `<file> (<source>)`, or `(built-in example; …)` — this checkout's hub.toml).
console_url() {
  local flag=() prev="" cfg port
  for a in "$@"; do
    [ "$prev" = "--config" ] && flag=(--config "$a")
    case "$a" in --config=*) flag=("$a") ;; esac
    prev="$a"
  done
  cfg="$(cd "$ROOT" && "$HUB" config path ${flag[@]+"${flag[@]}"} 2>/dev/null)" || return 0
  case "$cfg" in "(built-in"*) cfg="$ROOT/hub.toml" ;; *) cfg="${cfg% (*}" ;; esac
  [ "$(toml_get "$cfg" console enabled)" = "false" ] && return 0
  port="$(toml_get "$cfg" console port)"
  echo "http://127.0.0.1:${port:-9098}"
}

# `key` from `[section]` of a TOML file (first match; plain `key = value` lines only).
toml_get() {
  awk -v s="[$2]" -v k="$3" '
    /^\[/ { in_s = ($1 == s) }
    in_s && $1 == k && $2 == "=" { print $3; exit }' "$1" 2>/dev/null
}

# Open the console once it answers, in the background, while the hub runs in front.
open_console() {
  [ -z "${TUSSEN_NO_OPEN:-}" ] || return 0
  local url; url="$(console_url "$@")"; [ -n "$url" ] || return 0
  (
    for _ in $(seq 100); do curl -s -o /dev/null "$url/" && break; sleep 0.1; done
    if command -v open >/dev/null; then open "$url"
    elif command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1
    fi
  ) &
}

build_hub
case "${1:-}" in
  install) shift; install_hub "$@" ;;
  run)     open_console ${ARGS[@]+"${ARGS[@]}"}; cd "$ROOT" && exec "$HUB" ${ARGS[@]+"${ARGS[@]}"} ;;
  ""|help|-h|--help)
           rc=0; (cd "$ROOT" && "$HUB" ${ARGS[@]+"${ARGS[@]}"}) || rc=$?
           echo
           echo "./tussen adds: install [--prefix DIR] (simply-tussen into DIR/bin, default ~/.local/bin),"
           echo "and run also opens the console in your browser (TUSSEN_NO_OPEN=1 skips it)."
           exit "$rc" ;;
  *)       cd "$ROOT" && exec "$HUB" ${ARGS[@]+"${ARGS[@]}"} ;;
esac
