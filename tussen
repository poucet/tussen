#!/usr/bin/env bash
# ./tussen [args…] — build the hub, start it, print the console URL and the OSC
# endpoint, open the console; Ctrl-C stops it. The config is the hub's own pick
# (`tussen-hub config path`): --config, else ~/.config/tussen/hub.toml (or
# $XDG_CONFIG_HOME/tussen/hub.toml), else the repo's hub.toml.
#
# Args pass through to `tussen-hub run`: --fake-midi, --fake-pad (no hardware needed),
# --audio-device <name>, --config <path>. TUSSEN_NO_OPEN=1 skips opening the console.
# Other hub commands: hub/target/release/tussen-hub --help.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
HUB="$ROOT/hub/target/release/tussen-hub"

die() { echo "tussen: $*" >&2; exit 1; }

build_hub() {
  command -v cargo >/dev/null || die "cargo not found; install Rust from https://rustup.rs"
  (cd "$ROOT/hub" && cargo build --release --quiet)
}

# The hub config in use, as the hub resolves it: `<path> (<source>)` → `<path>`.
hub_config() {
  local flag=() prev="" line
  for a in "$@"; do [ "$prev" = "--config" ] && flag=(--config "$a"); prev="$a"; done
  line="$(cd "$ROOT" && "$HUB" config path ${flag[@]+"${flag[@]}"})" || return 0
  echo "${line% (*}"
}

# `key` from `[section]` of a TOML file (first match; plain `key = value` lines only).
toml_get() {
  awk -v s="[$2]" -v k="$3" '
    /^\[/ { in_s = ($1 == s) }
    in_s && $1 == k && $2 == "=" { print $3; exit }' "$1" 2>/dev/null
}

lan_ip() {
  ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null ||
    { hostname -I 2>/dev/null | awk '{print $1}'; } || true
}

# Wait for the hub, then print where to reach it. Sets CONSOLE_URL (empty if disabled).
announce() {
  local cfg port osc lan
  cfg="$(hub_config "$@")"
  port="$(toml_get "$cfg" console port)"; port="${port:-9098}"
  osc="$(toml_get "$cfg" osc listen_port)"; osc="${osc:-9000}"
  lan="$(lan_ip)"; lan="${lan:-?}"
  CONSOLE_URL=""
  if [ "$(toml_get "$cfg" console enabled)" = "false" ]; then
    echo "tussen hub console → disabled in $cfg"
  else
    for _ in $(seq 50); do curl -s -o /dev/null "http://127.0.0.1:$port/" && break; sleep 0.1; done
    CONSOLE_URL="http://127.0.0.1:$port"
    echo "tussen hub console → $CONSOLE_URL"
  fi
  echo "hub OSC            → $lan:$osc  (local: 127.0.0.1:$osc)"
}

open_console() {
  [ -n "$CONSOLE_URL" ] && [ -z "${TUSSEN_NO_OPEN:-}" ] || return 0
  if command -v open >/dev/null; then open "$CONSOLE_URL"
  elif command -v xdg-open >/dev/null; then xdg-open "$CONSOLE_URL" >/dev/null 2>&1
  fi
}

run_hub() {
  (cd "$ROOT" && exec "$HUB" run "$@") &
  HUB_PID=$!
  trap 'kill "$HUB_PID" 2>/dev/null; wait "$HUB_PID" 2>/dev/null; echo "hub stopped"' EXIT
  trap 'exit 130' INT TERM
  announce "$@"
  open_console
  wait "$HUB_PID"
}

build_hub
run_hub "$@"
